  "test_cases": [
    {
      "id": "tc_001_shanghai_solo_citywalk_budget",
      "title": "上海 2 天独行城市漫步与美食",
      "input": {
        "destination": "shanghai",
        "days": 2,
        "budget": 1800,
        "preferences": "city_walk history food",
        "traveler_type": "solo"
      },
      "expectations": {
        "expected_preferences": ["city_walk", "history", "food"],
        "daily_poi_range": [2, 5],
        "max_daily_hours": 8,
        "max_warning_count": 0,
        "notes": "合成场景，用于检查低预算下是否优先城市步行、历史街区和本地餐饮。"
